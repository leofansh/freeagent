__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
# 本机跑全量测试时用的 ``--basetemp`` 落点（沙箱拦pytest 清理
# ``%TEMP%\pytest-of-*``，只能指到仓库内；跑完一两次就能到几百 MB）。
.pytest-tmp/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# 本地数据（原型默认落在仓库根，测试用 tmpdir）
*.db
*.db-journal
*.db-wal
*.db-shm

# agent 工具状态与调试产物。
# .omo/ 是会话续跑状态（只有 sessionID 与时间戳，对项目没有价值）；
# .playwright-mcp/ 是页面 DOM 快照与浏览器控制台日志，可能含浏览过的页面内容。
.omo/
.playwright-mcp/
.codegraph/

# 运行时日志（_bridge.log、data/web.log）
*.log

# 本机运行产物。``data/`` 装的是日志与执行器分页日志，``config.json`` 是
# opencode 的**本机权限配置**（含本机路径与个人偏好）—— 两者都是这台机器
# 的状态，不是项目内容。提交它们会让 clone 出来的人莫名多一个空目录，
# 而 config.json 还会覆盖他自己那份 opencode 配置。
data/
config.json

# 批处理变量未展开时留下的字面量目录（FreeAgentProvider 的已知环境隐患）
%FREEAGENT_HOME%/

# 工具会话状态（跨会话记忆），与项目内容无关。
# 与上面 .omo/ 同理：存的是会话与时间戳，对项目没有价值。
.workbuddy/

# tests/manual/ 冒烟脚本每次重新生成的截图与临时运行目录。
e2e_final.png
wb_smoke.png
tests/manual/shots/
.smoke/

# 引擎委派闸门残留的本机覆盖层：它是项目级配置、会覆盖 clone 出来的人
# 自己的那份，且正常委派结束会自动删除，留着只说明上次被强杀。
opencode.jsonc

# 真机走查抓下来的 SSE 帧，含本机临时路径与会话数据，不是项目内容。
tests/manual/sse_capture.jsonl

# 桌面打包下载的 embeddable Python 缓存（zip + .part 分片，几十 MB 二进制），
# 每次构建重新下载即可，不是项目内容。
tools/pack/.cache/
