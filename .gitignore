__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# 本地数据（原型默认落在仓库根，测试用 tmpdir）
*.db
*.db-journal
*.db-wal
*.db-shm

# agent 工具状态与调试产物。
# .omo/ 是会话续跑状态（只有 sessionID 与时间戳，对项目没有价值）；
# .playwright-mcp/ 是页面 DOM 快照与浏览器控制台日志，可能含浏览过的页面内容。
.omo/
.playwright-mcp/
.codegraph/

# 运行时日志（_bridge.log、data/web.log）
*.log

# 本机运行产物。``data/`` 装的是日志与执行器分页日志，``config.json`` 是
# opencode 的**本机权限配置**（含本机路径与个人偏好）—— 两者都是这台机器
# 的状态，不是项目内容。提交它们会让 clone 出来的人莫名多一个空目录，
# 而 config.json 还会覆盖他自己那份 opencode 配置。
data/
config.json

# 批处理变量未展开时留下的字面量目录（FreeAgentProvider 的已知环境隐患）
%FREEAGENT_HOME%/

# 工具会话状态（跨会话记忆），与项目内容无关。
# 与上面 .omo/ 同理：存的是会话与时间戳，对项目没有价值。
.workbuddy/

# tests/manual/e2e_browser_smoke.py 每次冒烟都会重新生成的截图。
e2e_final.png
